{
    "name": "gratlinie/contao-provisionsrechner",
    "description": "Provisionsrechner für Contao: vergleicht die Provision einer Bestellplattform mit den Kosten eines eigenen Shops",
    "keywords": ["contao", "restaurant", "provision", "rechner", "lieferando"],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Gratlinie",
            "email": "mail@gratlinie.de",
            "homepage": "https://www.gratlinie.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Gratlinie\\ProvisionsrechnerBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Gratlinie\\ProvisionsrechnerBundle\\ContaoManager\\Plugin"
    }
}
